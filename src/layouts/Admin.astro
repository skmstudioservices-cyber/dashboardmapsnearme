---
import '../styles/global.css';

interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;
const user = Astro.locals.user;
const BASE = (import.meta.env.BASE_URL ?? '').replace(/\/$/, '');
const nav = [
  { href: `${BASE}/`, label: 'Overview', key: 'home' },
  { href: `${BASE}/businesses`, label: 'Businesses', key: 'businesses' },
  { href: `${BASE}/claims`, label: 'Claims', key: 'claims' },
  { href: `${BASE}/feedback`, label: 'Feedback', key: 'feedback' },
  { href: `${BASE}/keywords`, label: 'Keywords', key: 'keywords' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — mapsnearme Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="theme-color" content="#334155" />
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href={`${BASE}/`}>
          <span class="mark">M</span>
          <span>maps<b>near me</b></span>
          <span class="admin-tag">Admin</span>
        </a>
        <nav>
          {nav.map((n) => (
            <a class={`link${active === n.key ? ' active' : ''}`} href={n.href}>{n.label}</a>
          ))}
          <span class="whoami">{user?.email ?? ''}</span>
          <form method="post" action={`${BASE}/api/logout`} class="logout-form">
            <button class="btn btn-ghost" type="submit">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section">
        <p class="eyebrow">Admin</p>
        <h1 class="page-title">{title} <span class="accent">·</span></h1>
        <slot />
      </section>
    </main>

    <footer class="site-footer">
      <div class="container foot-bottom">
        <span>mapsnearme admin — internal tool</span>
        <span>© {new Date().getFullYear()} mapsnearme</span>
      </div>
    </footer>
  </body>
</html>
